# ── Build-time variables (baked into the JS bundle by Vite) ──
VITE_API_URL=http://localhost:8000/api
VITE_AUTH_MODE=mock

# ── Runtime variables (injected by docker-entrypoint.sh) ──
BACKEND_URL=http://localhost:8000

# ── Integrated Docker development stack ──
POSTGRES_USER=hack_user
POSTGRES_PASSWORD=hack_password
POSTGRES_DB=hackathon_db
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
