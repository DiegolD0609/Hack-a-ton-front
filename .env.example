# ── Build-time variables (baked into the JS bundle by Vite) ──
# The browser calls /api/*. Nginx proxies it to BACKEND_URL and strips /api,
# keeping REST and WebSocket traffic same-origin from the browser's perspective.
# This is what Studio (the only page the app currently renders) actually uses.
VITE_API_URL=/api
# Raster tiles for RouteMap.tsx (MapLibre GL) — used by Studio's `map` node
# and by the legacy runtime. Keep OSM attribution visible.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ── Everything below is legacy runtime only (workflows/runs/WebSocket) ──
# ── Studio does not read these. Kept for when that code gets a route again. ──
# Demo-only WebSocket handshake token. Match backend DEMO_TOKEN.
VITE_DEMO_TOKEN=replace-with-a-shared-demo-token
# Enable snapshot polling while the WebSocket reconnects.
VITE_RUNTIME_POLLING=true
# Hide the Ari panel when the backend assistant kill switch is disabled.
VITE_ASSISTANT_ENABLED=true

# ── Runtime variables (injected by docker-entrypoint.sh) ──
# The deployed frontend uses the separate Railway backend by default. Override
# this only for a staging or local backend.
BACKEND_URL=https://hack-a-ton-end-production.up.railway.app
