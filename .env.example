# ── Build-time variables (baked into the JS bundle by Vite) ──
# Local dev (npm run dev, no Docker/Nginx in front): point straight at FastAPI, no /api prefix.
VITE_API_URL=http://127.0.0.1:8000 
# Docker/Nginx build: Nginx proxies /api/* to BACKEND_URL and strips the /api prefix.
# VITE_API_URL=http://localhost:8000/api

# ── Runtime variables (injected by docker-entrypoint.sh) ──
BACKEND_URL=http://localhost:8000
