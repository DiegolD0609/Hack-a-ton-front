# ── Build-time variables (baked into the JS bundle by Vite) ──
# Vite and Nginx proxy /api/* to BACKEND_URL and strip the /api prefix.
VITE_API_URL=/api
# Demo-only WebSocket handshake token. Match backend DEMO_TOKEN.
VITE_DEMO_TOKEN=replace-with-a-shared-demo-token
# Enable snapshot polling while the WebSocket reconnects.
VITE_RUNTIME_POLLING=true

# ── Runtime variables (injected by docker-entrypoint.sh) ──
BACKEND_URL=http://localhost:8000
